
{{> head }}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">

<body class="bg-[#f4f2f9] text-gray-800 antialiased min-h-screen overflow-x-hidden font-['Inter']">

  <!-- Ultra Glossy iPhone 2026 Glass Background -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute -top-48 -left-48 w-[560px] h-[560px] bg-violet-300/35 rounded-full blur-[140px] animate-blob-1"></div>
    <div class="absolute top-1/4 -right-40 w-[480px] h-[480px] bg-pink-300/30 rounded-full blur-[120px] animate-blob-2"></div>
    <div class="absolute -bottom-48 left-1/4 w-[520px] h-[520px] bg-indigo-200/35 rounded-full blur-[130px] animate-blob-3"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-purple-200/25 rounded-full blur-[160px] animate-pulse-slow"></div>

    <div class="absolute inset-0 bg-[linear-gradient(rgba(139,92,246,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(139,92,246,0.035)_1px,transparent_1px)] bg-[size:72px_72px]"></div>

    <div class="absolute top-[16%] left-[15%] w-1.5 h-1.5 bg-white rounded-full shadow-[0_0_8px_2px_rgba(255,255,255,0.8)] animate-twinkle"></div>
    <div class="absolute top-[32%] right-[18%] w-1 h-1 bg-pink-200 rounded-full shadow-[0_0_6px_1px_rgba(251,207,232,0.9)] animate-twinkle" style="animation-delay:1.4s;"></div>
    <div class="absolute bottom-[26%] left-[25%] w-1.5 h-1.5 bg-violet-200 rounded-full shadow-[0_0_8px_2px_rgba(196,181,253,0.8)] animate-twinkle" style="animation-delay:2.8s;"></div>
  </div>

  <!-- Centered Login Content -->
  <div class="min-h-screen flex items-center justify-center px-5 py-16">
    <div class="w-full max-w-[420px]">

      <!-- Glossy Glass Card -->
      <div class="relative rounded-[32px] bg-white/60 backdrop-blur-[32px] border border-white/90 
                  shadow-[0_20px_60px_rgba(139,92,246,0.10),0_8px_24px_rgba(236,72,153,0.06),inset_0_1px_0_rgba(255,255,255,1)]
                  overflow-hidden animate-hero-float">

        <!-- Soft top gloss highlight -->
        <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/50 to-transparent pointer-events-none rounded-t-[32px]"></div>

        <!-- Subtle shine sweep -->
        <div class="absolute inset-0 overflow-hidden rounded-[32px] pointer-events-none">
          <div class="absolute -inset-full bg-gradient-to-r from-transparent via-white/20 to-transparent skew-x-12 animate-shine"></div>
        </div>

        <div class="relative z-10 px-8 sm:px-10 py-12">

          <!-- Logo -->
          <div class="text-center mb-9 animate-fade-up" style="animation-delay:0.1s;">
            <div class="mx-auto w-20 h-20 bg-gradient-to-br from-violet-500 via-purple-500 to-pink-500 
                        rounded-[22px] flex items-center justify-center shadow-[0_8px_28px_rgba(139,92,246,0.35)] mb-6
                        hover:scale-105 transition-transform duration-500">
              <i class="fas fa-crown text-3xl text-yellow-100"></i>
            </div>

            <h1 class="text-3xl sm:text-[2.1rem] font-black font-['Playfair_Display'] tracking-tight">
              <span class="bg-gradient-to-r from-violet-600 via-purple-500 to-pink-500 bg-clip-text text-transparent">
                EventFair
              </span>
            </h1>
            <p class="mt-2 text-[15px] font-semibold text-gray-600">Judge Scoring Tabulation System</p>
            <p class="mt-3 text-[12.5px] text-emerald-600 font-medium flex items-center justify-center gap-1.5">
              <i class="fas fa-shield-check text-[11px]"></i>
              Secure • Encrypted • Trusted
            </p>
          </div>

          <!-- Form -->
          <form method="POST" action="/login" class="space-y-5">

            <!-- Email -->
            <div class="animate-fade-up" style="animation-delay:0.2s;">
              <label class="flex items-center gap-2 text-[13px] font-semibold text-violet-700 mb-2">
                <i class="fas fa-envelope text-[12px]"></i> Email Address
              </label>
              <div class="relative">
                <input type="email" name="email" required placeholder="admin@eventfair.com"
                       class="w-full pl-12 pr-5 py-4 bg-white/70 border border-violet-100 rounded-2xl 
                              focus:border-violet-400 focus:ring-4 focus:ring-violet-500/15 outline-none 
                              transition-all duration-300 text-gray-800 text-[14.5px] font-medium placeholder-gray-400
                              shadow-[inset_0_1px_2px_rgba(0,0,0,0.02)]">
                <i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-violet-400 text-[15px]"></i>
              </div>
            </div>

            <!-- Password -->
            <div class="animate-fade-up" style="animation-delay:0.3s;">
              <label class="flex items-center gap-2 text-[13px] font-semibold text-purple-700 mb-2">
                <i class="fas fa-lock text-[12px]"></i> Password
              </label>
              <div class="relative">
                <input type="password" name="password" required placeholder="Enter your password"
                       class="w-full pl-12 pr-5 py-4 bg-white/70 border border-purple-100 rounded-2xl 
                              focus:border-purple-400 focus:ring-4 focus:ring-purple-500/15 outline-none 
                              transition-all duration-300 text-gray-800 text-[14.5px] font-medium placeholder-gray-400
                              shadow-[inset_0_1px_2px_rgba(0,0,0,0.02)]">
                <i class="fas fa-key absolute left-4 top-1/2 -translate-y-1/2 text-purple-400 text-[15px]"></i>
              </div>
            </div>

            <!-- Sign In Button -->
            <div class="pt-3 animate-fade-up" style="animation-delay:0.4s;">
              <button type="submit"
                      class="w-full py-4 bg-gradient-to-r from-violet-500 via-purple-500 to-pink-500 
                             hover:from-violet-600 hover:via-purple-600 hover:to-pink-600 
                             text-white font-semibold text-[15px] rounded-2xl 
                             shadow-[0_8px_28px_rgba(236,72,153,0.3)] 
                             hover:shadow-[0_12px_36px_rgba(236,72,153,0.4)] 
                             hover:scale-[1.02] active:scale-[0.98]
                             transition-all duration-300 flex items-center justify-center gap-2.5
                             relative overflow-hidden group">
                <span class="relative z-10 flex items-center gap-2.5">
                  <i class="fas fa-sign-in-alt group-hover:translate-x-1 transition-transform duration-300"></i>
                  Sign In
                </span>
                <div class="absolute inset-0 bg-white/20 -translate-x-full group-hover:translate-x-full 
                            transition-transform duration-700"></div>
              </button>
            </div>
          </form>

        </div>
      </div>

    </div>
  </div>

  <!-- ANIMATIONS -->
  <style>
    @keyframes blob-1 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(45px, -30px) scale(1.07); }
      66% { transform: translate(-20px, 35px) scale(0.97); }
    }
    @keyframes blob-2 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-55px, 30px); }
    }
    @keyframes blob-3 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(40px, -45px); }
    }
    @keyframes pulse-slow {
      0%, 100% { opacity: 0.45; transform: translate(-50%, -50%) scale(1); }
      50% { opacity: 0.7; transform: translate(-50%, -50%) scale(1.05); }
    }
    @keyframes twinkle {
      0%, 100% { opacity: 0.4; transform: scale(0.9); }
      50% { opacity: 1; transform: scale(1.3); }
    }
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes hero-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-7px); }
    }
    @keyframes shine {
      0% { transform: translateX(-120%) skewX(-12deg); }
      100% { transform: translateX(220%) skewX(-12deg); }
    }

    .animate-blob-1 { animation: blob-1 20s ease-in-out infinite; }
    .animate-blob-2 { animation: blob-2 24s ease-in-out infinite; }
    .animate-blob-3 { animation: blob-3 28s ease-in-out infinite; }
    .animate-pulse-slow { animation: pulse-slow 14s ease-in-out infinite; }
    .animate-twinkle { animation: twinkle 4s ease-in-out infinite; }

    .animate-fade-up {
      opacity: 0;
      animation: fade-up 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .animate-hero-float {
      animation: hero-float 7s ease-in-out infinite;
    }
    .animate-shine {
      animation: shine 8s ease-in-out infinite;
      animation-delay: 1.8s;
    }
  </style>

{{> footer }}
</body>
