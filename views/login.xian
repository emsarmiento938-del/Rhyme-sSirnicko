{{> head}}

<div class="min-h-screen flex items-center justify-center px-5 py-16 sm:py-20">
  <div class="w-full max-w-[420px]">
    <div class="relative rounded-[32px] bg-white/65 backdrop-blur-[32px] border border-white/90 shadow-[0_20px_60px_rgba(139,92,246,0.12),0_8px_24px_rgba(236,72,153,0.06),inset_0_1px_0_rgba(255,255,255,1)] overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/55 to-transparent pointer-events-none rounded-t-[32px]"></div>
      <div class="absolute inset-0 overflow-hidden rounded-[32px] pointer-events-none">
        <div class="absolute -inset-full bg-gradient-to-r from-transparent via-white/25 to-transparent skew-x-12 animate-[shine_8s_ease-in-out_infinite]"></div>
      </div>

      <div class="relative z-10 px-8 sm:px-10 py-10 sm:py-12">
        <div class="text-center mb-8 animate-[fade-up_0.75s_ease-out_forwards]">
          <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-[22px] bg-gradient-to-br from-violet-500 via-purple-500 to-pink-500 shadow-[0_8px_28px_rgba(139,92,246,0.35)]">
            <i class="fas fa-crown text-3xl text-yellow-100"></i>
          </div>
          <h1 class="text-3xl font-black tracking-tight font-['Playfair_Display']">
            <span class="bg-gradient-to-r from-violet-600 via-purple-500 to-pink-500 bg-clip-text text-transparent">EventFair</span>
          </h1>
          <p class="mt-2 text-[15px] font-semibold text-gray-600">Judge Scoring Tabulation System</p>
          <p class="mt-3 flex items-center justify-center gap-1.5 text-[12.5px] font-medium text-emerald-600">
            <i class="fas fa-shield-check text-[11px]"></i>
            Secure • Encrypted • Trusted
          </p>
        </div>

        <form method="POST" action="/login" class="space-y-5">
          <div class="animate-[fade-up_0.75s_ease-out_forwards]" style="animation-delay:0.15s;">
            <label class="mb-2 flex items-center gap-2 text-[13px] font-semibold text-violet-700">
              <i class="fas fa-envelope text-[12px]"></i> Email Address
            </label>
            <div class="relative">
              <input type="email" name="email" required placeholder="admin@eventfair.com"
                     class="w-full rounded-2xl border border-violet-100 bg-white/75 py-4 pl-12 pr-5 text-[14.5px] font-medium text-gray-800 shadow-[inset_0_1px_2px_rgba(0,0,0,0.02)] outline-none transition-all duration-300 placeholder-gray-400 focus:border-violet-400 focus:ring-4 focus:ring-violet-500/15">
              <i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-[15px] text-violet-400"></i>
            </div>
          </div>

          <div class="animate-[fade-up_0.75s_ease-out_forwards]" style="animation-delay:0.25s;">
            <label class="mb-2 flex items-center gap-2 text-[13px] font-semibold text-purple-700">
              <i class="fas fa-lock text-[12px]"></i> Password
            </label>
            <div class="relative">
              <input type="password" name="password" required placeholder="Enter your password"
                     class="w-full rounded-2xl border border-purple-100 bg-white/75 py-4 pl-12 pr-5 text-[14.5px] font-medium text-gray-800 shadow-[inset_0_1px_2px_rgba(0,0,0,0.02)] outline-none transition-all duration-300 placeholder-gray-400 focus:border-purple-400 focus:ring-4 focus:ring-purple-500/15">
              <i class="fas fa-key absolute left-4 top-1/2 -translate-y-1/2 text-[15px] text-purple-400"></i>
            </div>
          </div>

          <div class="pt-2 animate-[fade-up_0.75s_ease-out_forwards]" style="animation-delay:0.35s;">
            <button type="submit" class="group relative flex w-full items-center justify-center gap-2.5 overflow-hidden rounded-2xl bg-gradient-to-r from-violet-500 via-purple-500 to-pink-500 py-4 text-[15px] font-semibold text-white shadow-[0_8px_28px_rgba(236,72,153,0.3)] transition-all duration-300 hover:from-violet-600 hover:via-purple-600 hover:to-pink-600 hover:scale-[1.02] hover:shadow-[0_12px_36px_rgba(236,72,153,0.4)] active:scale-[0.98]">
              <span class="relative z-10 flex items-center gap-2.5">
                <i class="fas fa-sign-in-alt transition-transform duration-300 group-hover:translate-x-1"></i>
                Sign In
              </span>
              <div class="absolute inset-0 -translate-x-full bg-white/20 transition-transform duration-700 group-hover:translate-x-full"></div>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes shine {
    0% { transform: translateX(-120%) skewX(-12deg); }
    100% { transform: translateX(220%) skewX(-12deg); }
  }
</style>

{{> footer}}
