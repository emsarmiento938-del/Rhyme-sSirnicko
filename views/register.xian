{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-100 via-pink-50 to-purple-100 min-h-screen font-['Inter'] antialiased flex flex-col overflow-x-hidden">

  <!-- LIVE ANIMATED BACKGROUND (Fixed + Scrollable) -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 -left-40 w-96 h-96 bg-violet-400 rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob-1"></div>
    <div class="absolute top-32 -right-32 w-80 h-80 bg-pink-400 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-blob-2"></div>
    <div class="absolute bottom-0 left-1/3 w-96 h-96 bg-purple-400 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-blob-3"></div>

    <!-- Floating Crown -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-15">
      <i class="fas fa-crown text-9xl text-yellow-300 animate-float-slow"></i>
    </div>

    <!-- Sparkles -->
    <div class="sparkles">
      <i class="fas fa-star text-yellow-300 absolute text-2xl opacity-70 animate-twinkle" style="top:15%;left:12%;animation-delay:0s;"></i>
      <i class="fas fa-star text-pink-300 absolute text-xl opacity-60 animate-twinkle" style="top:28%;right:18%;animation-delay:1.8s;"></i>
      <i class="fas fa-star text-violet-400 absolute text-2xl opacity-70 animate-twinkle" style="bottom:22%;left:15%;animation-delay:3.2s;"></i>
      <i class="fas fa-sparkles text-yellow-400 absolute text-3xl opacity-80 animate-twinkle" style="top:45%;left:70%;animation-delay:2.5s;"></i>
      <i class="fas fa-heart text-pink-500 absolute text-xl opacity-70 animate-twinkle" style="bottom:30%;right:10%;animation-delay:4s;"></i>
    </div>
  </div>

  <!-- SCROLLABLE CONTENT -->
  <div class="flex-1 flex flex-col items-center justify-center px-6 py-16 min-h-screen">
    <div class="w-full max-w-md">

      <!-- Register Card -->
      <div class="bg-white/95 backdrop-blur-2xl rounded-3xl shadow-2xl border border-white/60 p-10 space-y-8 
                  hover:shadow-pink-500/40 transition-all duration-700">

        <!-- Gradient Top Bar -->
        <div class="h-2 bg-gradient-to-r from-violet-600 via-purple-600 to-pink-600 rounded-t-3xl"></div>

        <!-- Logo & Title -->
        <div class="text-center -mt-16">
          <div class="mx-auto w-28 h-28 bg-gradient-to-br from-violet-600 via-purple-600 to-pink-600 
                      rounded-3xl flex items-center justify-center shadow-2xl mb-6 
                      hover:scale-110 hover:rotate-6 transition-all duration-700 ring-8 ring-white/50">
            <i class="fas fa-crown text-5xl text-yellow-300 drop-shadow-2xl"></i>
          </div>

          <h2 class="text-5xl font-black font-['Playfair_Display']">
            <span class="bg-gradient-to-r from-violet-700 via-purple-600 to-pink-600 bg-clip-text text-transparent 
                         animate-gradient-shift">
              EventFair
            </span>
          </h2>
          <p class="mt-2 text-xl font-bold text-violet-700">Judge Tabulation System</p>
          <p class="mt-4 text-sm text-gray-600 flex items-center justify-center gap-2">
            <i class="fas fa-shield-check text-emerald-600 animate-pulse"></i>
            <span class="font-medium text-emerald-700">Secure • Encrypted • Trusted</span>
          </p>
        </div>

        <!-- FORM -->
        <form method="POST" action="/register" class="space-y-7 mt-8">

          <!-- Full Name -->
          <div>
            <label class="flex items-center gap-3 text-sm font-bold text-violet-800 mb-2">
              <i class="fas fa-user text-violet-600"></i> Full Name
            </label>
            <div class="relative">
              <input type="text" name="name" required placeholder="Your Full Name"
                     class="w-full pl-14 pr-6 py-5 bg-white/80 border-2 border-violet-200 rounded-2xl 
                            focus:border-violet-500 focus:ring-4 focus:ring-violet-500/30 outline-none 
                            transition-all duration-300 text-gray-800 font-medium placeholder-gray-400">
              <i class="fas fa-user-check absolute left-5 top-1/2 -translate-y-1/2 text-violet-600 text-lg"></i>
            </div>
          </div>

          <!-- Email -->
          <div>
            <label class="flex items-center gap-3 text-sm font-bold text-violet-800 mb-2">
              <i class="fas fa-envelope-open-text text-violet-600"></i> Email Address
            </label>
            <div class="relative">
              <input type="email" name="email" required placeholder="admin@eventfair.com"
                     class="w-full pl-14 pr-6 py-5 bg-white/80 border-2 border-violet-200 rounded-2xl 
                            focus:border-violet-500 focus:ring-4 focus:ring-violet-500/30 outline-none 
                            transition-all duration-300 text-gray-800 font-medium placeholder-gray-400">
              <i class="fas fa-user-crown absolute left-5 top-1/2 -translate-y-1/2 text-violet-600 text-lg"></i>
            </div>
          </div>

          <!-- Password -->
          <div>
            <label class="flex items-center gap-3 text-sm font-bold text-purple-800 mb-2">
              <i class="fas fa-lock-keyhole text-purple-600"></i> Password
            </label>
            <div class="relative">
              <input type="password" name="password" required placeholder="Create your royal key"
                     class="w-full pl-14 pr-6 py-5 bg-white/80 border-2 border-purple-200 rounded-2xl 
                            focus:border-purple-500 focus:ring-4 focus:ring-purple-500/30 outline-none 
                            transition-all duration-300 text-gray-800 font-medium placeholder-gray-400">
              <i class="fas fa-key absolute left-5 top-1/2 -translate-y-1/2 text-purple-600 text-lg"></i>
            </div>
          </div>

          <!-- REGISTER BUTTON -->
          <button type="submit"
                  class="w-full py-6 mt-10 bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 
                          hover:from-emerald-700 hover:via-teal-700 hover:to-cyan-700 
                          text-white font-black text-xl rounded-2xl shadow-2xl 
                          hover:shadow-emerald-600/60 transform hover:scale-105 active:scale-98 
                          transition-all duration-400 flex items-center justify-center gap-3 
                          relative overflow-hidden group">
            <span class="relative z-10 flex items-center gap-3">
              <i class="fas fa-user-plus group-hover:translate-x-2 transition-transform"></i>
              Create Account
            </span>
            <div class="absolute inset-0 bg-white/30 -translate-x-full group-hover:translate-x-full 
                        transition-transform duration-1000"></div>
          </button>

        </form>

        <!-- LOGIN LINK -->
        <div class="text-center pt-6 border-t border-gray-200">
          <p class="text-gray-700 font-medium">
            Already have an account? 
            <a href="/login" class="text-violet-700 font-bold hover:text-violet-900 transition hover:underline">
              Sign In Here
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- ANIMATIONS -->
  <style>
    @keyframes blob-1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(50px,-80px) scale(1.15); } }
    @keyframes blob-2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-60px,100px); } }
    @keyframes blob-3 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(80px,-50px); } }
    @keyframes float-slow { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-25px); } }
    @keyframes twinkle { 0%,100% { opacity: 0.4; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.3); } }
    @keyframes gradient-shift { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

    .animate-blob-1 { animation: blob-1 22s infinite ease-in-out; }
    .animate-blob-2 { animation: blob-2 26s infinite ease-in-out; }
    .animate-blob-3 { animation: blob-3 30s infinite ease-in-out; }
    .animate-float-slow { animation: float-slow 10s ease-in-out infinite; }
    .animate-twinkle { animation: twinkle 4s infinite; }
    .animate-gradient-shift { animation: gradient-shift 8s ease infinite; background-size: 200% 200%; }
    .sparkles i { animation: twinkle 5s infinite; }
  </style>

{{> footer }}