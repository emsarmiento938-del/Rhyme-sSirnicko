{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <main class="flex-1 p-8">

      <!-- Print-only & Print-hide Styles -->
      <style>
        @media print {
          .no-print { display: none !important; }
          .violet-sidebar { display: none !important; }
          body { background: white !important; }
          main { padding: 2rem !important; width: 100% !important; }
          .print-title { font-size: 28pt !important; }
          .print-subtitle { font-size: 16pt !important; }
          .result-card { box-shadow: none !important; border: 2px solid #a78bfa !important; }
          .rank-1 { background: linear-gradient(135deg, #fbbf24, #f59e0b) !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
          .rank-2 { background: linear-gradient(135deg, #94a3b8, #64748b) !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
          .rank-3 { background: linear-gradient(135deg, #dc2626, #b91c1c) !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
      </style>

      <!-- Header Banner -->
      <div class="no-print mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-3xl shadow-2xl p-10 text-center">
        <div class="flex items-center justify-center gap-6 mb-4">
          <i class="fas fa-trophy text-7xl drop-shadow-2xl"></i>
          <div>
            <h1 class="text-6xl font-extrabold tracking-tight print-title">Official Results</h1>
            <p class="text-3xl font-bold mt-2 print-subtitle">{{round.name}}</p>
            <p class="text-pink-200 text-xl mt-3">Event Tabulation System • {{round.event.name}}</p>
            <p class="text-sm text-white/90 mt-2">Round order: <strong>{{round.order}}</strong> • Status: <strong>{{round.status}}</strong></p>
            {{#if round.description}}
              <p class="text-sm text-white/80 mt-1">{{round.description}}</p>
            {{/if}}
          </div>
          <i class="fas fa-medal text-7xl drop-shadow-2xl"></i>
        </div>
      </div>

      <!-- Print Button (only visible on screen) -->
      <div class="no-print flex items-center justify-between mb-8 gap-4">
        <div>
          <label for="roundSelect" class="text-sm text-white/90 mr-2">Choose Round:</label>
          <select id="roundSelect" class="rounded-md px-3 py-2 text-gray-800">
            {{#each rounds}}
              <option value="{{id}}" {{#if (eq id ../round.id)}}selected{{/if}}>Order {{order}} - {{name}}</option>
            {{/each}}
          </select>
          <button id="openRoundBtn" class="ml-3 inline-flex items-center gap-2 bg-white/10 text-white font-semibold py-2 px-4 rounded-md">
            <i class="fas fa-arrow-right"></i> Open
          </button>
        </div>

        <div>
          <button onclick="window.print()" 
                  class="inline-flex items-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-4 px-10 rounded-xl shadow-lg hover:shadow-2xl hover:shadow-pink-500/50 transform hover:scale-105 transition text-xl">
            <i class="fas fa-print"></i> Print / Save as PDF
          </button>
        </div>
      </div>

      <script>
        (function(){
          const sel = document.getElementById('roundSelect');
          const btn = document.getElementById('openRoundBtn');
          if (sel && btn) {
            btn.addEventListener('click', function(){
              const id = sel.value;
              if (!id) return;
              window.location.href = '/admin/result/print/' + id;
            });
            sel.addEventListener('change', function(){ /* optional immediate navigation */ });
          }
        })();
      </script>

      <!-- Results Table – Printable Format -->
      <div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200 border-collapse table-auto">
          <thead class="bg-violet-50">
            <tr>
              <th class="px-6 py-4 text-left text-sm font-medium text-gray-700">Rank</th>
              <th class="px-6 py-4 text-left text-sm font-medium text-gray-700">Participant</th>
              <th class="px-6 py-4 text-left text-sm font-medium text-gray-700">No. / Barangay</th>
              <th class="px-6 py-4 text-right text-sm font-medium text-gray-700">Final Raw Score</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            {{#each scoreboard}}
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 align-top text-sm text-gray-800">{{#if this.hasScores}}{{rankLabel @index}}{{else}}-{{/if}}</td>
                <td class="px-6 py-4 align-top text-sm text-gray-800">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-100 flex items-center justify-center">
                      {{#if this.participant.photo}}
                        <img src="{{this.participant.photo}}" alt="{{this.participant.name}}" class="w-full h-full object-cover">
                      {{else}}
                        <i class="fas fa-user text-xl text-gray-400"></i>
                      {{/if}}
                    </div>
                    <div>
                      <div class="font-semibold text-gray-900">{{this.participant.name}}</div>
                      <div class="text-xs text-gray-500">{{this.participant.barangay}}</div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 align-top text-sm text-gray-800">#{{this.participant.participantNumber}}</td>
                <td class="px-6 py-4 align-top text-sm font-bold text-right text-purple-800">{{this.finalRaw}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <!-- No Results Fallback -->
      {{#unless scoreboard.length}}
        <div class="text-center py-20">
          <i class="fas fa-trophy text-9xl text-purple-200 mb-8"></i>
          <h3 class="text-4xl font-bold text-gray-700">No Results Yet</h3>
          <p class="text-xl text-gray-500 mt-4">Scores are still being tabulated. Please check back later.</p>
        </div>
      {{/unless}}

    </main>
  </div>

  {{> footer}}
</body>