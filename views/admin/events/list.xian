{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}} <!-- Your violet + pink sidebar -->

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-8 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-18 h-18 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50">
            <i class="fas fa-calendar-star text-4xl text-white drop-shadow-lg"></i>
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight">Events Management</h1>
            <p class="text-pink-200 text-lg mt-1 font-medium">Event Tabulation System • Create & Manage Competitions</p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Flash Messages -->
      {{#if success_msg}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-5 mb-7 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-check-circle text-3xl text-green-600"></i>
          <p class="font-bold text-lg">{{success_msg}}</p>
        </div>
      {{/if}}
      {{#if error_msg}}
        <div class="bg-red-50 border-l-4 border-red-600 text-red-800 p-5 mb-7 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-exclamation-triangle text-3xl text-red-600"></i>
          <p class="font-bold text-lg">{{error_msg}}</p>
        </div>
      {{/if}}

      <!-- Create Event Button -->
      <div class="mb-8 text-right">
        <a href="/admin/events/create" 
           class="inline-flex items-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold text-lg px-8 py-4 rounded-xl shadow-xl hover:shadow-2xl hover:shadow-pink-500/40 transform hover:scale-105 transition-all duration-300">
          <i class="fas fa-plus-circle text-2xl"></i>
          Create New Event
        </a>
      </div>

      <!-- Events Table -->
      <div class="bg-white rounded-2xl shadow-2xl border border-purple-100 overflow-hidden">
        <div class="bg-gradient-to-r from-violet-700 to-pink-700 text-white p-6">
          <h2 class="text-2xl font-bold flex items-center gap-3">
            <i class="fas fa-list-alt"></i> All Events
          </h2>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-purple-50 text-purple-800 font-bold border-b-2 border-purple-200">
              <tr>
                <th class="text-left py-5 px-7">Event Name</th>
                <th class="text-left py-5 px-7">Date</th>
                <th class="text-left py-5 px-7">Venue</th>
                <th class="text-left py-5 px-7">Status</th>
                <th class="text-left py-5 px-7 text-center">Rounds</th>
                <th class="text-left py-5 px-7 text-center">Judges</th>
                <th class="text-left py-5 px-7 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {{#each events}}
              <tr class="hover:bg-purple-50 transition-all duration-300 group">
                <td class="py-5 px-7 font-bold text-purple-800 group-hover:text-violet-700">{{name}}</td>
                <td class="py-5 px-7 text-gray-700">{{date}}</td>
                <td class="py-5 px-7 text-gray-700">{{venue}}</td>
                <td class="py-5 px-7">
                  <span class="inline-block px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider
                    {{#if (eq status 'ongoing')}}bg-green-100 text-green-800 border border-green-300
                    {{else if (eq status 'upcoming')}}bg-violet-100 text-violet-800 border border-violet-300
                    {{else if (eq status 'completed')}}bg-gray-200 text-gray-700 border border-gray-400
                    {{else}}bg-rose-100 text-rose-800 border border-rose-300{{/if}}">
                    {{status}}
                  </span>
                </td>
                <td class="py-5 px-7 text-center font-semibold text-purple-700">{{rounds.length}}</td>
                <td class="py-5 px-7 text-center font-semibold text-pink-700">{{judges.length}}</td>
                <td class="py-5 px-7">
                  <div class="flex items-center justify-center gap-3">

                    <!-- View -->
                    <a href="/admin/events/{{id}}" class="group relative" title="View Event">
                      <div class="w-11 h-11 rounded-full bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300">
                        <i class="fas fa-eye text-white text-lg"></i>
                      </div>
                      <span class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs px-3 py-1.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">View</span>
                    </a>

                    <!-- Edit -->
                    <a href="/admin/events/{{id}}/edit" class="group relative" title="Edit Event">
                      <div class="w-11 h-11 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300">
                        <i class="fas fa-edit text-white text-lg"></i>
                      </div>
                      <span class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs px-3 py-1.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Edit</span>
                    </a>

                    <!-- Archive -->
                    <form method="POST" action="/admin/events/{{id}}/archive" class="inline">
                      <button type="submit" class="group relative" title="Archive Event">
                        <div class="w-11 h-11 rounded-full bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300">
                          <i class="fas fa-archive text-white text-lg"></i>
                        </div>
                        <span class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs px-3 py-1.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Archive</span>
                      </button>
                    </form>

                    <!-- Delete -->
                    <form method="POST" action="/admin/events/{{id}}/delete" class="inline" onsubmit="return confirm('Permanently delete this event? This cannot be undone.')">
                      <button type="submit" class="group relative" title="Delete Event">
                        <div class="w-11 h-11 rounded-full bg-gradient-to-br from-rose-500 to-red-600 flex items-center justify-center shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300">
                          <i class="fas fa-trash-alt text-white text-lg"></i>
                        </div>
                        <span class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs px-3 py-1.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Delete</span>
                      </button>
                    </form>

                  </div>
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="7" class="text-center py-16">
                  <div class="flex flex-col items-center">
                    <div class="w-24 h-24 mb-6 rounded-full bg-gradient-to-br from-violet-200 to-pink-200 flex items-center justify-center">
                      <i class="fas fa-calendar-times text-5xl text-violet-600 opacity-50"></i>
                    </div>
                    <p class="text-xl font-bold text-gray-600">No events created yet</p>
                    <p class="text-gray-500 mt-2">Click "Create New Event" to get started!</p>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

{{> footer}}
</body>