{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50">
            <i class="fas fa-edit text-4xl text-white drop-shadow-lg"></i>
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight">Edit Event</h1>
            <p class="text-pink-200 text-lg mt-1 font-medium">Event Tabulation System • Update Competition Details</p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Back Button -->
      <div class="mb-6">
        <a href="/admin/events/{{event.id}}" class="inline-flex items-center gap-3 text-violet-700 hover:text-violet-900 font-semibold text-lg hover:-translate-x-1 transition">
          <i class="fas fa-arrow-left text-xl"></i> Back to Event
        </a>
      </div>

      <!-- Error Message -->
      {{#if error_msg}}
        <div class="bg-red-50 border-l-4 border-red-600 text-red-800 p-6 mb-8 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-exclamation-triangle text-3xl text-red-600"></i>
          <p class="font-bold text-lg">{{error_msg}}</p>
        </div>
      {{/if}}

      <!-- Edit Event Form - Clean & Professional -->
      <div class="bg-white rounded-2xl shadow-2xl border border-purple-100 p-8 max-w-4xl mx-auto">
        <form method="POST" action="/admin/events/{{event.id}}/edit" class="space-y-8">

          <!-- Event Name -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-trophy text-pink-600"></i>
              Event Name <span class="text-red-600">*</span>
            </label>
            <input type="text" name="name" value="{{event.name}}" required placeholder="e.g., Mr. & Ms. Barangay 2025"
                   class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Description -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-align-left text-pink-600"></i>
              Description
            </label>
            <textarea name="description" rows="5" placeholder="Brief description of the event..."
                      class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base resize-none transition-all duration-300">{{event.description}}</textarea>
          </div>

          <!-- Date & Time -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-calendar-alt text-pink-600"></i>
              Date & Time <span class="text-red-600">*</span>
            </label>
            <input type="datetime-local" name="date" value="{{event.date}}" required
                   class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Venue -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-map-marker-alt text-pink-600"></i>
              Venue <span class="text-red-600">*</span>
            </label>
            <input type="text" name="venue" value="{{event.venue}}" required placeholder="e.g., Barangay Covered Court"
                   class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Status -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-circle-notch text-pink-600"></i>
              Event Status
            </label>
            <select name="status" class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
              <option value="upcoming" {{#if (eq event.status 'upcoming')}}selected{{/if}}>Upcoming</option>
              <option value="ongoing" {{#if (eq event.status 'ongoing')}}selected{{/if}}>Ongoing</option>
              <option value="completed" {{#if (eq event.status 'completed')}}selected{{/if}}>Completed</option>
              <option value="archived" {{#if (eq event.status 'archived')}}selected{{/if}}>Archived</option>
            </select>
          </div>

          <!-- Public Toggle -->
          <div class="flex items-center justify-between p-6 bg-purple-50 rounded-xl border border-purple-200">
            <div class="flex items-center gap-4">
              <i class="fas fa-globe text-3xl text-violet-700"></i>
              <div>
                <p class="text-xl font-bold text-purple-800">Public Event</p>
                <p class="text-purple-600">Allow public viewing via transparency portal</p>
              </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="isPublic" {{#if event.isPublic}}checked{{/if}} class="sr-only peer">
              <div class="w-14 h-8 bg-gray-300 rounded-full peer 
                          peer-checked:bg-gradient-to-r peer-checked:from-violet-600 peer-checked:to-pink-600
                          after:content-[''] after:absolute after:top-1 after:left-1 after:bg-white after:rounded-full 
                          after:h-6 after:w-6 after:transition-all peer-checked:after:translate-x-full">
              </div>
            </label>
          </div>

          <!-- Action Buttons - Normal Size -->
          <div class="flex flex-col sm:flex-row gap-4 pt-6">
            <button type="submit" 
                    class="flex-1 flex items-center justify-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg hover:shadow-xl hover:shadow-pink-500/40 transform hover:scale-105 transition-all duration-300 text-lg">
              <i class="fas fa-save"></i>
              Update Event
            </button>
            <a href="/admin/events/{{event.id}}" 
               class="flex-1 flex items-center justify-center gap-3 bg-gray-200 text-gray-800 font-bold py-3.5 px-8 rounded-xl hover:bg-gray-300 transform hover:scale-105 transition-all duration-300 text-lg">
              <i class="fas fa-times-circle"></i>
              Cancel
            </a>
          </div>

        </form>
      </div>

    </main>
  </div>

{{> footer}}
</body>