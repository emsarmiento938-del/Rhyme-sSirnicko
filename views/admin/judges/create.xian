{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50">
            <i class="fas fa-gavel text-4xl text-white drop-shadow-lg"></i>
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight">Add New Judge</h1>
            <p class="text-pink-200 text-lg mt-1 font-medium">Create a judge account for scoring events</p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Back Button -->
      <div class="mb-6">
        <a href="/admin/judges" class="inline-flex items-center gap-3 text-violet-700 hover:text-violet-900 font-semibold text-lg hover:-translate-x-1 transition">
          <i class="fas fa-arrow-left text-xl"></i> Back to Judges
        </a>
      </div>

      <!-- Add Judge Form – SK Dashboard Style -->
      <div class="bg-white rounded-2xl shadow-2xl border border-purple-100 p-10 max-w-2xl mx-auto">
        <form method="POST" action="/admin/judges/create" class="space-y-10">

          <!-- Judge Name -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-4">
              <i class="fas fa-user-tie text-pink-600"></i>
              Full Name <span class="text-red-600">*</span>
            </label>
            <input type="text" name="name" required placeholder="Enter judge's full name"
                   class="w-full px-6 py-4 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Email -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-4">
              <i class="fas fa-envelope text-pink-600"></i>
              Email Address <span class="text-red-600">*</span>
            </label>
            <input type="email" name="email" required placeholder="judge@example.com"
                   class="w-full px-6 py-4 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Password -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-4">
              <i class="fas fa-lock text-pink-600"></i>
              Password <span class="text-red-600">*</span>
            </label>
            <input type="password" name="password" required placeholder="Create a strong password"
                   class="w-full px-6 py-4 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-5 pt-8">
            <button type="submit" 
                    class="flex-1 flex items-center justify-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-4 px-8 rounded-xl shadow-lg hover:shadow-xl hover:shadow-pink-500/40 transform hover:scale-105 transition-all duration-300 text-lg">
              <i class="fas fa-user-plus"></i>
              Create Judge Account
            </button>
            <a href="/admin/judges" 
               class="flex-1 flex items-center justify-center gap-3 bg-gray-200 text-gray-800 font-bold py-4 px-8 rounded-xl hover:bg-gray-300 transform hover:scale-105 transition-all duration-300 text-lg">
              <i class="fas fa-times-circle"></i>
              Cancel
            </a>
          </div>
        </form>
      </div>

    </main>
  </div>

  {{> footer}}
</body>