{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Your existing sidebar --> 

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50">
            <i class="fas fa-gavel text-4xl text-white drop-shadow-lg"></i>
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight">Judges Management</h1>
            <p class="text-pink-200 text-lg mt-1 font-medium">Add, view and assign judges to events</p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Add Judge Button -->
      <div class="mb-8 text-right">
        <a href="/admin/judges/create" 
           class="inline-flex items-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition">
          <i class="fas fa-plus"></i> Add New Judge
        </a>
      </div>

      <!-- Success Message -->
      {{#if success_msg}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-6 mb-8 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-check-circle text-3xl text-green-600"></i>
          <p class="font-bold text-lg">{{success_msg}}</p>
        </div>
      {{/if}}

      <!-- Judges Grid – SK Dashboard Style -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
        {{#each judges}}
          <div class="bg-white rounded-2xl shadow-xl border border-purple-100 overflow-hidden hover:shadow-2xl transform hover:scale-105 transition-all duration-300">
            <!-- Header -->
            <div class="bg-gradient-to-r from-violet-600 to-pink-600 text-white p-6">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 bg-white/20 backdrop-blur rounded-full flex items-center justify-center">
                    <i class="fas fa-user-tie text-3xl"></i>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold">{{name}}</h3>
                    <p class="text-pink-100 text-sm">{{email}}</p>
                  </div>
                </div>
                <!-- Status Badge -->
                <span class="px-4 py-2 rounded-full text-sm font-bold
                             {{#if isActive}}bg-emerald-100 text-emerald-800 border border-emerald-300
                             {{else}}bg-rose-100 text-rose-800 border border-rose-300{{/if}}">
                  {{#if isActive}}Active{{else}}Inactive{{/if}}
                </span>
              </div>
            </div>

            <!-- Body -->
            <div class="p-6 space-y-6">
              <!-- Assigned Events Count -->
              <div class="text-center py-6 bg-purple-50 rounded-xl border border-purple-200">
                <i class="fas fa-calendar-check text-4xl text-violet-600 mb-3"></i>
                <p class="text-3xl font-black text-purple-800">{{assignedEvents.length}}</p>
                <p class="text-sm text-purple-600 font-medium">Assigned Events</p>
              </div>

              <!-- Action Buttons -->
              <div class="grid grid-cols-2 gap-4">
                <!-- Assign to Event -->
                <form method="POST" action="/admin/judges/assign-all" class="col-span-1">
                  <input type="hidden" name="judgeId" value="{{id}}">
                  <button type="submit" 
                          class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold py-3 rounded-lg hover:from-emerald-600 hover:to-teal-700 transform hover:scale-105 transition flex items-center justify-center gap-2">
                    <i class="fas fa-tasks"></i>
                    Assign
                  </button>
                </form>

                <!-- Delete Judge -->
                <form method="POST" action="/admin/judges/{{id}}/delete" class="col-span-1" onsubmit="return confirm('Delete {{name}} permanently?')">
                  <button type="submit" 
                          class="w-full bg-gradient-to-r from-rose-500 to-pink-600 text-white font-bold py-3 rounded-lg hover:from-rose-600 hover:to-pink-700 transform hover:scale-105 transition flex items-center justify-center gap-2">
                    <i class="fas fa-trash-alt"></i>
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        {{else}}
          <!-- Empty State -->
          <div class="col-span-full text-center py-20 bg-white rounded-2xl shadow-xl border border-purple-100">
            <i class="fas fa-gavel text-9xl text-purple-200 mb-6"></i>
            <h3 class="text-3xl font-bold text-gray-700 mb-3">No Judges Added Yet</h3>
            <p class="text-gray-500 text-lg mb-8">Start building your judging panel by adding the first judge.</p>
            <a href="/admin/judges/create" 
               class="inline-flex items-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-4 px-10 rounded-xl hover:shadow-xl transform hover:scale-105 transition">
              <i class="fas fa-plus"></i> Add Your First Judge
            </a>
          </div>
        {{/each}}
      </div>

    </main>
  </div>

  {{> footer}}
</body>