{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50">
            <i class="fas fa-layer-group text-4xl text-white drop-shadow-lg"></i>
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight">Competition Rounds</h1>
            <p class="text-pink-200 text-lg mt-1 font-medium">Event: <span class="font-bold">{{event.name}}</span></p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <a href="/admin/events/{{event.id}}" class="inline-flex items-center gap-3 text-violet-700 hover:text-violet-900 font-semibold text-lg hover:-translate-x-1 transition">
          <i class="fas fa-arrow-left text-xl"></i> Back to Event
        </a>
        <a href="/admin/events/{{event.id}}/rounds/create" 
           class="inline-flex items-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition">
          <i class="fas fa-plus"></i> Create New Round
        </a>
      </div>

      <!-- Success Message -->
      {{#if success_msg}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-6 mb-8 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-check-circle text-3xl text-green-600"></i>
          <p class="font-bold text-lg">{{success_msg}}</p>
        </div>
      {{/if}}

      <!-- Rounds Grid - Card View (SK Dashboard Style) -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
        {{#each rounds}}
          <div class="bg-white rounded-2xl shadow-xl border border-purple-100 overflow-hidden hover:shadow-2xl transform hover:scale-105 transition-all duration-300">
            <div class="bg-gradient-to-r from-violet-600 to-pink-600 text-white p-5">
              <div class="flex justify-between items-start">
                <h3 class="text-xl font-bold">{{name}}</h3>
                <span class="text-3xl font-bold opacity-80">#{{order}}</span>
              </div>
            </div>

            <div class="p-6 space-y-5">
              <!-- Status Badge -->
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-gray-600">Status</span>
                <span class="px-4 py-2 rounded-full text-sm font-bold
                  {{#if (eq status 'open')}}bg-green-100 text-green-800 border border-green-300
                  {{else if (eq status 'closed')}}bg-red-100 text-red-800 border border-red-300
                  {{else}}bg-amber-100 text-amber-800 border border-amber-300{{/if}}">
                  {{status}}
                </span>
              </div>

              <!-- Counts -->
              <div class="grid grid-cols-2 gap-4 text-center">
                <div class="bg-purple-50 rounded-xl p-4 border border-purple-200">
                  <i class="fas fa-list-ul text-2xl text-violet-600 mb-2"></i>
                  <p class="text-2xl font-bold text-purple-800">{{criteria.length}}</p>
                  <p class="text-xs text-purple-600">Criteria</p>
                </div>
                <div class="bg-pink-50 rounded-xl p-4 border border-pink-200">
                  <i class="fas fa-users text-2xl text-pink-600 mb-2"></i>
                  <p class="text-2xl font-bold text-purple-800">{{participants.length}}</p>
                  <p class="text-xs text-pink-600">Participants</p>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex gap-3 pt-4 border-t border-purple-100">
                <a href="/admin/rounds/{{id}}/criteria" 
                   class="flex-1 text-center bg-violet-600 text-white py-3 rounded-lg hover:bg-violet-700 transition font-medium text-sm">
                  <i class="fas fa-list-ul mr-1"></i> Criteria
                </a>
                <a href="/admin/rounds/{{id}}/participants" 
                   class="flex-1 text-center bg-emerald-600 text-white py-3 rounded-lg hover:bg-emerald-700 transition font-medium text-sm">
                  <i class="fas fa-user-friends mr-1"></i> Participants
                </a>
                <a href="/admin/rounds/{{id}}/scoreboard" 
                   class="flex-1 text-center bg-pink-600 text-white py-3 rounded-lg hover:bg-pink-700 transition font-medium text-sm">
                  <i class="fas fa-trophy mr-1"></i> Scoreboard
                </a>
              </div>

              <!-- Delete Button -->
              <form method="POST" action="/admin/rounds/{{id}}/delete" class="mt-4" onsubmit="return confirm('Delete this round permanently?')">
                <button type="submit" class="w-full bg-red-100 text-red-700 hover:bg-red-200 font-medium py-3 rounded-lg transition flex items-center justify-center gap-2">
                  <i class="fas fa-trash-alt"></i> Delete Round
                </button>
              </form>
            </div>
          </div>
        {{else}}
          <!-- Empty State -->
          <div class="col-span-full text-center py-20">
            <i class="fas fa-layer-group text-9xl text-purple-200 mb-6"></i>
            <h3 class="text-2xl font-bold text-gray-700 mb-2">No Rounds Created Yet</h3>
            <p class="text-gray-500 text-lg">Start building your competition structure by creating the first round.</p>
            <a href="/admin/events/{{event.id}}/rounds/create" 
               class="mt-6 inline-flex items-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-4 px-8 rounded-xl hover:shadow-xl transform hover:scale-105 transition">
              <i class="fas fa-plus"></i> Create First Round
            </a>
          </div>
        {{/each}}
      </div>

    </main>
  </div>

{{> footer}}
</body>