{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50">
            <i class="fas fa-users text-4xl text-white drop-shadow-lg"></i>
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight">Manage Participants</h1>
            <p class="text-pink-200 text-lg mt-1 font-medium">Round: <span class="font-bold">{{round.name}}</span></p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Back Button -->
      <div class="mb-6">
        <a href="/admin/events/{{round.event.id}}/rounds" class="inline-flex items-center gap-3 text-violet-700 hover:text-violet-900 font-semibold text-lg hover:-translate-x-1 transition">
          <i class="fas fa-arrow-left text-xl"></i> Back to Rounds
        </a>
      </div>

      <!-- Success / Error Messages -->
      {{#if success_msg}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-6 mb-8 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-check-circle text-3xl text-green-600"></i>
          <p class="font-bold text-lg">{{success_msg}}</p>
        </div>
      {{/if}}
      {{#if error_msg}}
        <div class="bg-red-50 border-l-4 border-red-600 text-red-800 p-6 mb-8 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-exclamation-triangle text-3xl text-red-600"></i>
          <p class="font-bold text-lg">{{error_msg}}</p>
        </div>
      {{/if}}

      <!-- Participants Assignment Form - SK Dashboard Style -->
      <form method="POST" action="/admin/participants/assign-bulk" class="bg-white rounded-2xl shadow-2xl border border-purple-100 p-8">
        <input type="hidden" name="roundId" value="{{round.id}}">

        <div class="mb-8">
          <h3 class="text-2xl font-bold text-purple-800 flex items-center gap-3">
            <i class="fas fa-user-check text-pink-600"></i>
            Select Participants for This Round
          </h3>
          <p class="text-gray-600 mt-2">Check the participants you want to include in <strong>{{round.name}}</strong></p>
        </div>

        <!-- Participants Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {{#each allParticipants}}
          <label class="relative block cursor-pointer group">
            <input type="checkbox" name="participantIds" value="{{id}}" 
                   {{#if (includes ../assignedIds id)}}checked{{/if}} 
                   class="sr-only peer">

            <!-- Card -->
            <div class="bg-white border-2 rounded-2xl p-6 text-center transition-all duration-300
                        {{#if (includes ../assignedIds id)}}
                          border-emerald-400 shadow-xl shadow-emerald-100 ring-4 ring-emerald-100
                        {{else}}
                          border-purple-200 hover:border-violet-500 hover:shadow-xl hover:shadow-violet-100 peer-checked:border-violet-600 peer-checked:ring-4 peer-checked:ring-violet-100
                        {{/if}}">

              <!-- Avatar Circle -->
              <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-gradient-to-br {{#if (includes ../assignedIds id)}}from-emerald-400 to-teal-500{{else}}from-violet-400 to-pink-400{{/if}} flex items-center justify-center shadow-lg">
                <i class="fas fa-user text-3xl text-white"></i>
              </div>

              <!-- Name & Barangay -->
              <h4 class="font-bold text-lg text-purple-800 group-hover:text-violet-700 transition">
                {{name}}
              </h4>
              <p class="text-sm text-gray among-600 mt-1">{{barangay}}</p>

              <!-- Assigned Badge -->
              {{#if (includes ../assignedIds id)}}
                <div class="mt-4">
                  <span class="inline-flex items-center px-4 py-2 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                    Assigned
                  </span>
                </div>
              {{else}}
                <div class="mt-4 opacity-0 peer-checked:opacity-100 transition-opacity">
                  <span class="inline-flex items-center px-4 py-2 rounded-full text-xs font-bold bg-violet-100 text-violet-800 border border-violet-300">
                    Will be assigned
                  </span>
                </div>
              {{/if}}
            </div>

            <!-- Custom Checkmark (top-right) -->
            <div class="absolute top-3 right-3 w-8 h-8 rounded-full border-2 transition-all duration-300
                        {{#if (includes ../assignedIds id)}}
                          bg-emerald-500 border-emerald-500
                        {{else}}
                          bg-white border-gray-300 peer-checked:bg-violet-600 peer-checked:border-violet-600
                        {{/if}}">
              <i class="fas fa-check text-white text-sm opacity-0 peer-checked:opacity-100 transition {{@index}}"></i>
            </div>
          </label>
          {{/each}}
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mt-10 pt-6 border-t border-purple-100">
          <button type="submit" 
                  class="flex-1 flex items-center justify-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-4 px-8 rounded-xl shadow-lg hover:shadow-xl hover:shadow-pink-500/40 transform hover:scale-105 transition-all duration-300 text-lg">
            <i class="fas fa-save"></i>
            Update Participant Assignments
          </button>
          <a href="/admin/events/{{round.event.id}}/rounds" 
             class="flex-1 flex items-center justify-center gap-3 bg-gray-200 text-gray-800 font-bold py-4 px-8 rounded-xl hover:bg-gray-300 transform hover:scale-105 transition-all duration-300 text-lg">
            <i class="fas fa-times-circle"></i>
            Cancel
          </a>
        </div>
      </form>

    </main>
  </div>

{{> footer}}
</body>