{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-24 h-24 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50 overflow-hidden">
            {{#if participant.photo}}
              <img src="{{participant.photo}}" alt="{{participant.name}}" class="w-full h-full object-cover">
            {{else}}
              <i class="fas fa-user text-5xl text-white drop-shadow-lg"></i>
            {{/if}}
          </div>
          <div>
            <h1 class="text-5xl font-extrabold tracking-tight">{{participant.name}}</h1>
            <p class="text-pink-200 text-xl mt-2 font-medium">
              Participant #{{participant.participantNumber}} • {{participant.barangay}}
            </p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Back + Edit Buttons -->
      <div class="mb-8 flex justify-between items-center">
        <a href="/admin/participants" class="inline-flex items-center gap-3 text-violet-700 hover:text-violet-900 font-semibold text-lg hover:-translate-x-1 transition">
          <i class="fas fa-arrow-left text-xl"></i> Back to Participants
        </a>
        <a href="/admin/participants/{{participant.id}}/edit"
           class="inline-flex items-center gap-3 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition">
          <i class="fas fa-edit"></i> Edit Participant
        </a>
      </div>

      <!-- Main Content Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Participant Details Card -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-xl border border-purple-100 p-8">
          <h2 class="text-3xl font-bold text-purple-800 mb-8 flex items-center gap-3">
            <i class="fas fa-id-card text-pink-600"></i> Participant Details
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-lg">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-purple-100 rounded-xl flex items-center justify-center">
                <i class="fas fa-user text-2xl text-purple-700"></i>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Full Name</p>
                <p class="font-bold text-purple-800">{{participant.name}}</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-pink-100 rounded-xl flex items-center justify-center">
                <i class="fas fa-map-marker-alt text-2xl text-pink-700"></i>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Barangay</p>
                <p class="font-bold text-purple-800">{{participant.barangay}}</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-violet-100 rounded-xl flex items-center justify-center">
                <i class="fas fa-hashtag text-2xl text-violet-700"></i>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Participant Number</p>
                <p class="font-black text-2xl text-violet-800">#{{participant.participantNumber}}</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-14 h-14 {{#if participant.isActive}}bg-emerald-100{{else}}bg-rose-100{{/if}} rounded-xl flex items-center justify-center">
                <i class="fas fa-circle text-xl {{#if participant.isActive}}text-emerald-600{{else}}text-rose-600{{/if}}"></i>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Status</p>
                <p class="font-bold {{#if participant.isActive}}text-emerald-700{{else}}text-rose-700{{/if}}">
                  {{#if participant.isActive}}Active{{else}}Inactive{{/if}}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Assigned Rounds Card -->
        <div class="bg-white rounded-2xl shadow-xl border border-purple-100 p-8">
          <h2 class="text-3xl font-bold text-purple-800 mb-8 flex items-center gap-3">
            <i class="fas fa-trophy text-pink-600"></i> Assigned Rounds
          </h2>

          {{#if participant.rounds.length}}
            <div class="space-y-5">
              {{#each participant.rounds}}
                <div class="bg-gradient-to-r from-violet-50 to-pink-50 p-6 rounded-xl border border-purple-200 hover:shadow-lg transform hover:scale-105 transition-all duration-300">
                  <div class="flex items-center justify-between">
                    <div>
                      <h4 class="font-bold text-purple-800 text-lg">{{name}}</h4>
                      <p class="text-sm text-gray-600 mt-1">{{event.name}}</p>
                    </div>
                    <i class="fas fa-arrow-right text-violet-600 text-2xl"></i>
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class="text-center py-12">
              <i class="fas fa-trophy text-8xl text-purple-200 mb-6"></i>
              <p class="text-xl font-medium text-gray-600">Not assigned to any rounds yet</p>
              <p class="text-gray-500 mt-2">This participant will appear in scoreboards once assigned.</p>
            </div>
          {{/if}}
        </div>

      </div>

    </main>
  </div>

  {{> footer}}
</body>