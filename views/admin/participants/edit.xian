{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-24 h-24 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50 overflow-hidden">
            {{#if participant.photo}}
              <img src="{{participant.photo}}" alt="{{participant.name}}" class="w-full h-full object-cover">
            {{else}}
              <i class="fas fa-user text-5xl text-white drop-shadow-lg"></i>
            {{/if}}
          </div>
          <div>
            <h1 class="text-5xl font-extrabold tracking-tight">Edit Participant</h1>
            <p class="text-pink-200 text-xl mt-2 font-medium">
              #{{participant.participantNumber}} • {{participant.name}}
            </p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Back Button -->
      <div class="mb-6">
        <a href="/admin/participants/{{participant.id}}" class="inline-flex items-center gap-3 text-violet-700 hover:text-violet-900 font-semibold text-lg hover:-translate-x-1 transition">
          <i class="fas fa-arrow-left text-xl"></i> Back to Participant
        </a>
      </div>

      <!-- Edit Form Card – SK Dashboard Style -->
      <div class="bg-white rounded-2xl shadow-2xl border border-purple-100 p-10 max-w-3xl mx-auto">
        <form method="POST" action="/admin/participants/{{participant.id}}/edit" enctype="multipart/form-data" class="space-y-10">

          <!-- Current Photo Preview -->
          {{#if participant.photo}}
          <div class="text-center">
            <p class="text-lg font-medium text-gray-700 mb-4">Current Photo</p>
            <div class="inline-block rounded-2xl overflow-hidden shadow-xl ring-4 ring-purple-200">
              <img src="{{participant.photo}}" alt="Current Photo" class="w-48 h-48 object-cover">
            </div>
          </div>
          {{/if}}

          <!-- Update Photo -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-4">
              <i class="fas fa-camera text-pink-600"></i> Update Photo
            </label>
            <input type="file" name="photo" accept="image/*"
                   class="w-full px-6 py-5 border-2 border-dashed border-purple-300 rounded-xl text-gray-700 file:mr-6 file:py-3 file:px-8 file:rounded-full file:border-0 file:bg-gradient-to-r file:from-violet-600 file:to-pink-600 file:text-white file:font-bold hover:file:from-violet-700 hover:file:to-pink-700 transition">
            <p class="text-sm text-gray-500 mt-3">Leave empty to keep current photo • Max 5MB (JPEG, PNG, GIF)</p>
          </div>

          <!-- Name -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-4">
              <i class="fas fa-user text-pink-600"></i> Full Name <span class="text-red-600">*</span>
            </label>
            <input type="text" name="name" value="{{participant.name}}" required placeholder="Enter full name"
                   class="w-full px-6 py-4 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-lg transition">
          </div>

          <!-- Barangay -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-4">
              <i class="fas fa-map-marker-alt text-pink-600"></i> Barangay <span class="text-red-600">*</span>
            </label>
            <input type="text" name="barangay" value="{{participant.barangay}}" required placeholder="e.g., Barangay Poblacion"
                   class="w-full px-6 py-4 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-lg transition">
          </div>

          <!-- Participant Number -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-4">
              <i class="fas fa-hashtag text-pink-600"></i> Participant Number
            </label>
            <input type="text" name="participantNumber" value="{{participant.participantNumber}}" placeholder="Leave empty to keep current"
                   class="w-full px-6 py-4 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-lg transition">
          </div>

          <!-- Status Toggle -->
          <div class="flex items-center justify-between bg-purple-50 rounded-xl p-6">
            <div class="flex items-center gap-4">
              <i class="fas fa-circle text-3xl {{#if participant.isActive}}text-emerald-600{{else}}text-gray-400{{/if}}"></i>
              <div>
                <p class="font-bold text-purple-800 text-xl">Participant Status</p>
                <p class="text-gray-600">Toggle to activate or deactivate this participant</p>
              </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="isActive" {{#if participant.isActive}}checked{{/if}} class="sr-only peer">
              <div class="w-14 h-8 bg-gray-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-violet-300 rounded-full peer 
                          peer-checked:after:translate-x-full peer-checked:after:border-white 
                          after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all 
                          peer-checked:bg-gradient-to-r peer-checked:from-violet-600 peer-checked:to-pink-600"></div>
            </label>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-5 pt-8">
            <button type="submit"
                    class="flex-1 flex items-center justify-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-5 px-10 rounded-xl shadow-lg hover:shadow-xl hover:shadow-pink-500/40 transform hover:scale-105 transition-all duration-300 text-xl">
              <i class="fas fa-save"></i> Update Participant
            </button>
            <a href="/admin/participants/{{participant.id}}"
               class="flex-1 flex items-center justify-center gap-3 bg-gray-200 text-gray-800 font-bold py-5 px-10 rounded-xl hover:bg-gray-300 transform hover:scale-105 transition-all duration-300 text-xl">
              <i class="fas fa-times-circle"></i> Cancel
            </a>
          </div>

        </form>
      </div>

    </main>
  </div>

  {{> footer}}
</body>