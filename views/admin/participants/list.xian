{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50">
            <i class="fas fa-users text-4xl text-white drop-shadow-lg"></i>
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight">Participants Management</h1>
            <p class="text-pink-200 text-lg mt-1 font-medium">View and manage all registered contestants</p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Add Participant Button -->
      <div class="mb-8 text-right">
        <a href="/admin/participants/create"
           class="inline-flex items-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition">
          <i class="fas fa-user-plus"></i> Add New Participant
        </a>
      </div>

      <!-- Success Message -->
      {{#if success_msg}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-6 mb-8 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-check-circle text-3xl text-green-600"></i>
          <p class="font-bold text-lg">{{success_msg}}</p>
        </div>
      {{/if}}

      <!-- Participants Grid – SK Dashboard Style -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-8">
        {{#each participants}}
          <div class="bg-white rounded-2xl shadow-xl border border-purple-100 overflow-hidden hover:shadow-2xl transform hover:scale-105 transition-all duration-300">
            <!-- Photo Header -->
            <div class="relative h-56 bg-gradient-to-br from-violet-200 to-pink-200">
              {{#if photo}}
                <img src="{{photo}}" alt="{{name}}" class="w-full h-full object-cover">
              {{else}}
                <div class="w-full h-full flex items-center justify-center">
                  <i class="fas fa-user text-9xl text-purple-300 opacity-50"></i>
                </div>
              {{/if}}
              <!-- Participant Number Badge -->
              <div class="absolute top-4 right-4 bg-white/95 backdrop-blur px-4 py-2 rounded-full shadow-lg">
                <span class="font-black text-2xl text-purple-800">#{{participantNumber}}</span>
              </div>
              <!-- Status Badge -->
              <div class="absolute bottom-4 left-4">
                <span class="px-4 py-2 rounded-full text-sm font-bold
                             {{#if isActive}}bg-emerald-100 text-emerald-800 border border-emerald-300
                             {{else}}bg-rose-100 text-rose-800 border border-rose-300{{/if}}">
                  {{#if isActive}}Active{{else}}Inactive{{/if}}
                </span>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-6">
              <h3 class="text-2xl font-bold text-purple-800 mb-1">{{name}}</h3>
              <p class="text-lg text-gray-600 mb-6 flex items-center gap-2">
                <i class="fas fa-map-marker-alt text-pink-600"></i> {{barangay}}
              </p>

              <!-- Action Buttons -->
              <div class="grid grid-cols-3 gap-3">
                <a href="/admin/participants/{{id}}" 
                   class="flex flex-col items-center justify-center py-4 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-xl transition">
                  <i class="fas fa-eye text-xl mb-1"></i>
                  <span class="text-xs font-bold">View</span>
                </a>
                <a href="/admin/participants/{{id}}/edit" 
                   class="flex flex-col items-center justify-center py-4 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded-xl transition">
                  <i class="fas fa-edit text-xl mb-1"></i>
                  <span class="text-xs font-bold">Edit</span>
                </a>
                <form method="POST" action="/admin/participants/{{id}}/delete" class="inline" onsubmit="return confirm('Delete {{name}} permanently?')">
                  <button type="submit" 
                          class="w-full flex flex-col items-center justify-center py-4 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-xl transition">
                    <i class="fas fa-trash-alt text-xl mb-1"></i>
                    <span class="text-xs font-bold">Delete</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
        {{else}}
          <!-- Empty State -->
          <div class="col-span-full text-center py-20 bg-white rounded-2xl shadow-xl border border-purple-100">
            <i class="fas fa-users text-9xl text-purple-200 mb-6"></i>
            <h3 class="text-3xl font-bold text-gray-700 mb-3">No Participants Yet</h3>
            <p class="text-gray-500 text-lg mb-8">Start building your contestant lineup by adding the first participant.</p>
            <a href="/admin/participants/create"
               class="inline-flex items-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-4 px-10 rounded-xl hover:shadow-xl transform hover:scale-105 transition">
              <i class="fas fa-user-plus"></i> Add First Participant
            </a>
          </div>
        {{/each}}
      </div>

    </main>
  </div>

  {{> footer}}
</body>