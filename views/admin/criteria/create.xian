{{> head}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<body class="bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50 min-h-screen font-sans">

  <div class="flex">
    {{> adminsidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="mb-10 bg-gradient-to-r from-violet-700 via-purple-700 to-pink-700 text-white rounded-2xl shadow-2xl p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gradient-to-br from-pink-400 to-violet-500 rounded-full flex items-center justify-center shadow-2xl ring-4 ring-pink-300/50">
            <i class="fas fa-clipboard-list text-4xl text-white drop-shadow-lg"></i>
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight">Create New Criteria</h1>
            <p class="text-pink-200 text-lg mt-1 font-medium">Round: <span class="font-bold">{{round.name}}</span></p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-pink-200 text-sm">Welcome back,</p>
          <p class="text-2xl font-bold">{{user.name}}</p>
        </div>
      </div>

      <!-- Back Button -->
      <div class="mb-6">
        <a href="/admin/rounds/{{round.id}}/criteria" class="inline-flex items-center gap-3 text-violet-700 hover:text-violet-900 font-semibold text-lg hover:-translate-x-1 transition">
          <i class="fas fa-arrow-left text-xl"></i> Back to Criteria
        </a>
      </div>

      <!-- Flash Messages -->
      {{#if success_msg}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-6 mb-8 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-check-circle text-3xl text-green-600"></i>
          <p class="font-bold text-lg">{{success_msg}}</p>
        </div>
      {{/if}}
      {{#if error_msg}}
        <div class="bg-red-50 border-l-4 border-red-600 text-red-800 p-6 mb-8 rounded-r-xl shadow-lg flex items-center gap-4">
          <i class="fas fa-exclamation-triangle text-3xl text-red-600"></i>
          <p class="font-bold text-lg">{{error_msg}}</p>
        </div>
      {{/if}}

      <!-- Create Criteria Form - SK Dashboard Style -->
      <div class="bg-white rounded-2xl shadow-2xl border border-purple-100 p-8 max-w-2xl mx-auto">
        <form method="POST" action="/admin/rounds/{{round.id}}/criteria/create" class="space-y-8">

          <!-- Criteria Name -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-tag text-pink-600"></i>
              Criteria Name <span class="text-red-600">*</span>
            </label>
            <input type="text" name="name" required placeholder="e.g., Stage Presence, Talent Execution"
                   class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Description -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-align-left text-pink-600"></i>
              Description
            </label>
            <textarea name="description" rows="5" placeholder="Describe what judges should look for in this criteria..."
                      class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base resize-none transition-all duration-300"></textarea>
          </div>

          <!-- Weight (%) -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-weight-hanging text-pink-600"></i>
              Weight (%) <span class="text-red-600">*</span>
            </label>
            <input type="number" name="weight" step="0.01" min="0" max="100" required placeholder="e.g., 30"
                   class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Max Score -->
          <div>
            <label class="flex items-center gap-3 text-xl font-bold text-purple-800 mb-3">
              <i class="fas fa-trophy text-pink-600"></i>
              Maximum Score <span class="text-red-600">*</span>
            </label>
            <input type="number" name="maxScore" step="0.01" min="1" value="100" required placeholder="e.g., 100"
                   class="w-full px-5 py-3.5 border border-purple-200 rounded-xl focus:border-violet-600 focus:ring-4 focus:ring-violet-100 text-base transition-all duration-300">
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 pt-6">
            <button type="submit" 
                    class="flex-1 flex items-center justify-center gap-3 bg-gradient-to-r from-violet-600 to-pink-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg hover:shadow-xl hover:shadow-pink-500/40 transform hover:scale-105 transition-all duration-300 text-lg">
              <i class="fas fa-plus-circle"></i>
              Create Criteria
            </button>
            <a href="/admin/rounds/{{round.id}}/criteria" 
               class="flex-1 flex items-center justify-center gap-3 bg-gray-200 text-gray-800 font-bold py-3.5 px-8 rounded-xl hover:bg-gray-300 transform hover:scale-105 transition-all duration-300 text-lg">
              <i class="fas fa-times-circle"></i>
              Cancel
            </a>
          </div>
        </form>
      </div>

    </main>
  </div>

{{> footer}}
</body>