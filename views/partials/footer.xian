<footer aria-label="Site footer" class="mt-12 group">
    <div 
        class="bg-violet-700/95 border-t-4 border-violet-500 transition-all duration-500 ease-in-out 
               group-hover:bg-violet-800 group-hover:shadow-2xl group-hover:shadow-violet-900/50"
    >
        <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-6">
            
            <div class="flex items-center gap-4 transition-transform duration-300 group-hover:scale-[1.02]">
                <div class="flex-shrink-0">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="drop-shadow-md">
                        <path d="M6 18H18V16H6V18ZM6 14H13V12H6V14ZM16 10L14 10L14 6L16 6L16 10ZM19 10L17 10L17 4L19 4L19 10Z" fill="#C4B5FD"/>
                        <path d="M6 10H10V6H6V10Z" fill="#FFFFFF"/>
                        <path d="M10 10H14V8H10V10Z" fill="#E0BBF4"/>
                    </svg>
                </div>
                <div>
                    <div class="text-white font-extrabold text-xl tracking-wider">BarangayFair</div>
                    <div class="text-xs text-violet-300/80 mt-0.5 font-medium">Tabulation & Administration System</div>
                </div>
            </div>

            <div class="text-sm text-violet-200 text-center md:text-right transition-transform duration-300 group-hover:translate-x-1">
                <div class="font-light">&copy; <span id="currentYear">2025</span> BarangayFair — All rights reserved.</div>
                <div class="text-xs text-violet-400 mt-1 font-extralight">Developed by Rhyme Lorenz M. Espino</div>
            </div>
        </div>
    </div>
</footer>

<script>
    (function(){
        try {
            var el = document.getElementById('currentYear');
            if (el) el.textContent = new Date().getFullYear();
        } catch(e) { /* ignore */ }
    })();
</script>
<!-- DataTables JS (initialise any tables with id "myTable") -->
<script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
<script>
    (function(){
        try {
            document.addEventListener('DOMContentLoaded', function(){
                // Initialize DataTable on every table with the "datatable" class
                if (typeof DataTable !== 'undefined') {
                    try {
                        var list = document.querySelectorAll('table.datatable');
                        list.forEach(function(tbl){
                            try { new DataTable(tbl); } catch(e){ console.error('DataTable init error for table', tbl, e); }
                        });
                    } catch(e) { console.error('DataTable init loop error', e); }
                }
            });
        } catch(e) { console.error(e); }
    })();
</script>
</body>
</html>