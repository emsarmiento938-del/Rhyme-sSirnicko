
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">
    
    <!-- Favicon with Crown -->
    <link rel="icon" href="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%23C084FC'/%3E%3Cpath d='M20 70 L50 30 L80 70 L70 55 L80 80 L50 60 L20 80 L30 55 Z' fill='%23FECDD3' stroke='%23FDE68A' stroke-width='8'/%3E%3C/svg%3E">

    <title>{{ title }}</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --header-height: 78px;
        }

        body {
            padding-top: var(--header-height);
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f3f1f8;
            color: #1e1b4b;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* === True iPhone-style Glass Header === */
        .royal-header {
            position: fixed;
            top: 12px;
            left: 16px;
            right: 16px;
            height: var(--header-height);
            z-index: 1000;
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(40px) saturate(200%);
            -webkit-backdrop-filter: blur(40px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.7);
            border-radius: 24px;
            box-shadow: 
                0 8px 32px rgba(139, 92, 246, 0.08),
                0 2px 8px rgba(0, 0, 0, 0.04),
                inset 0 1px 0 rgba(255, 255, 255, 0.9),
                inset 0 -1px 0 rgba(255, 255, 255, 0.3);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .royal-header:hover {
            background: rgba(255, 255, 255, 0.58);
            box-shadow: 
                0 12px 40px rgba(139, 92, 246, 0.12),
                0 4px 12px rgba(0, 0, 0, 0.05),
                inset 0 1px 0 rgba(255, 255, 255, 1),
                inset 0 -1px 0 rgba(255, 255, 255, 0.4);
        }

        /* Soft floating icon */
        @keyframes ios-float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-3px); }
        }
        .animate-ios-float { animation: ios-float 5.5s ease-in-out infinite; }

        /* Soft crown pulse */
        @keyframes pulse-soft {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .animate-crown-pulse { animation: pulse-soft 3.6s ease-in-out infinite; }

        /* Background animations */
        @keyframes blob-1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(40px, -25px) scale(1.06); }
            66% { transform: translate(-15px, 30px) scale(0.97); }
        }
        @keyframes blob-2 {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(-50px, 25px); }
        }
        @keyframes blob-3 {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(35px, -40px); }
        }
        @keyframes pulse-slow {
            0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(1); }
            50% { opacity: 0.65; transform: translate(-50%, -50%) scale(1.05); }
        }
        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(0.85); }
            50% { opacity: 0.95; transform: scale(1.25); }
        }

        .animate-blob-1 { animation: blob-1 20s ease-in-out infinite; }
        .animate-blob-2 { animation: blob-2 24s ease-in-out infinite; }
        .animate-blob-3 { animation: blob-3 28s ease-in-out infinite; }
        .animate-pulse-slow { animation: pulse-slow 14s ease-in-out infinite; }
        .animate-twinkle { animation: twinkle 4s ease-in-out infinite; }
    </style>
</head>
<body class="selection:bg-pink-500 selection:text-white antialiased">

<!-- iPhone 2026 Soft Glass Background -->
<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute -top-48 -left-48 w-[560px] h-[560px] bg-violet-300/30 rounded-full blur-[140px] animate-blob-1"></div>
    <div class="absolute top-1/4 -right-40 w-[480px] h-[480px] bg-pink-300/25 rounded-full blur-[120px] animate-blob-2"></div>
    <div class="absolute -bottom-48 left-1/4 w-[520px] h-[520px] bg-indigo-200/30 rounded-full blur-[130px] animate-blob-3"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-purple-200/20 rounded-full blur-[160px] animate-pulse-slow"></div>

    <!-- Subtle grid -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(139,92,246,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(139,92,246,0.025)_1px,transparent_1px)] bg-[size:72px_72px]"></div>

    <!-- Tiny light dots -->
    <div class="absolute top-[18%] left-[14%] w-1.5 h-1.5 bg-white rounded-full shadow-[0_0_8px_2px_rgba(255,255,255,0.7)] animate-twinkle"></div>
    <div class="absolute top-[35%] right-[16%] w-1 h-1 bg-pink-200 rounded-full shadow-[0_0_6px_1px_rgba(251,207,232,0.8)] animate-twinkle" style="animation-delay:1.4s;"></div>
    <div class="absolute bottom-[28%] left-[22%] w-1.5 h-1.5 bg-violet-200 rounded-full shadow-[0_0_8px_2px_rgba(196,181,253,0.7)] animate-twinkle" style="animation-delay:2.8s;"></div>
</div>

<!-- Floating Glass Header (iPhone style) -->
<header class="royal-header">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 h-full flex items-center justify-between relative z-10">
        
        <!-- Logo + Title -->
        <div class="flex items-center gap-3.5 sm:gap-4">
            <div class="relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-pink-400 to-violet-500 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-500"></div>
                <div class="relative w-11 h-11 sm:w-12 sm:h-12 bg-gradient-to-br from-violet-500 via-purple-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-[0_4px_16px_rgba(139,92,246,0.28)] animate-ios-float border border-white/60">
                    <i class="fas fa-crown text-xl sm:text-2xl text-amber-200 animate-crown-pulse drop-shadow-sm"></i>
                </div>
            </div>

            <div>
                <h1 class="text-xl sm:text-2xl font-black font-['Playfair_Display'] tracking-tight bg-gradient-to-r from-violet-700 via-purple-600 to-pink-600 bg-clip-text text-transparent leading-none">
                    EventFair
                </h1>
                <div class="flex items-center gap-1.5 mt-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-pink-500 animate-ping"></span>
                    <p class="text-[10px] sm:text-[11px] font-bold text-violet-600/75 tracking-[0.12em] uppercase">Judge Tabulation System</p>
                </div>
            </div>
        </div>

        <!-- Live Status Pill (Glass) -->
        <div class="hidden sm:flex items-center gap-2.5 bg-white/50 backdrop-blur-xl px-4 py-2 rounded-full border border-white/70 shadow-[0_2px_10px_rgba(139,92,246,0.05)]">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-semibold text-slate-700">System Live</span>
        </div>

    </div>
</header>

<!-- Main Content Container -->
<div class="bf-content-container relative z-10 pt-6">
    <!-- Your existing dashboard content goes here -->
</div>

</body>
</html>
