# Application Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eventtabulationsys
DB_USER=root
DB_PASSWORD=

# Railway will provide: MYSQL_URL, MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
# If using Railway MySQL, these will be auto-populated

# Session Secret (Change this to a random string in production)
SESSION_SECRET=xianfire-secret-key-change-in-production

# Admin Account Configuration
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@eventtabulation.com
ADMIN_PASSWORD=admin123

# Application URL (for production)
APP_URL=https://your-app-name.up.railway.app
